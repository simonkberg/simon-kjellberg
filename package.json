  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "next build --experimental-app-only",
    "dev": "next dev",
    "lint": "conc -g -c auto 'node:lint:*(!fix)'",
    "lint:fix": "node --run lint:oxlint:fix && node --run lint:oxfmt:fix",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxfmt:fix": "oxfmt .",
    "lint:oxlint": "oxlint --max-warnings=0 .",
    "lint:oxlint:fix": "oxlint --max-warnings=0 --fix .",
    "lint:tsc": "node --run typegen && tsc --noEmit",
    "prepare": "husky && node --run typegen",
    "start": "next start",
    "test": "vitest",
    "typegen": "SKIP_ENV_VALIDATION=1 next typegen"
  },
  "dependencies": {
    "@khanacademy/simple-markdown": "4.0.0",
