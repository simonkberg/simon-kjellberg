    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/ui": "5.0.4",
    "concurrently": "10.0.6",
    "happy-dom": "21.0.1",
    "husky": "9.1.7",
