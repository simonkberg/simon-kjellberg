    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "string-dedent": "3.0.2",
    "ts-extras": "1.3.0"
  },
  "devDependencies": {
    "@edge-runtime/cookies": "6.0.0",
