    "lint-staged": "17.6.0",
    "msw": "3.0.3",
    "oxc-transform-react": "0.154.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "pino-pretty": "13.2.0",
    "railway": "3.16.0",
